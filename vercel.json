{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix server && npm ci --prefix client",
  "buildCommand": "npm run build --prefix server && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 30, "includeFiles": "server/dist/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.mjs" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 4 * * *" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
