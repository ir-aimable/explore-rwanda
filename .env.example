# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/explore-rwanda.db
UPLOAD_DIR=../uploads

# ---- Initial administrator (used by db:seed / db:init). No default password is shipped. ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword1
ADMIN_NAME=Platform Administrator

# ---- Demo data password for seeded demo travelers/organizer (demo only) ----
DEMO_PASSWORD=DemoPass123

# ---- Optional integrations (platform works without them) ----
# Local LLM phrasing via Ollama; leave empty to use the built-in rule engine only
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# Weather uses Open-Meteo (no key required). Set to false to disable.
WEATHER_ENABLED=true
# Optional Google Maps embed key (ordinary map links are used if empty)
GOOGLE_MAPS_API_KEY=

# ---- Hosting on Vercel (leave empty for local development) ----
# Hosted database (Turso). Empty = local SQLite file at DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob store for uploaded photos. Empty = local UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=
# Sent by Vercel Cron to /api/cron/daily
CRON_SECRET=
